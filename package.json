{
  "name": "09-memoria-juego-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación móvil Expo SDK 58 + React Native + SQLite para 09 · Juego de memoria con puntajes",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:hook": "node --test .claude/hooks/pre-tool-use.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~58.0.26",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-location": "~58.0.22",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sensors": "~58.0.5",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "~5.8.2",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  }
}
