{
  "name": "09-memoria-juego-app",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación móvil Expo + React Native + SQLite para 09 · Juego de memoria con puntajes",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:hook": "node --test .claude/hooks/pre-tool-use.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-audio": "~0.3.0",
    "expo-haptics": "~14.0.1",
    "expo-location": "~18.0.7",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-sensors": "~14.0.2",
    "expo-sqlite": "~15.1.2",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.0.8",
    "eslint": "^9.21.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ]
  }
}
